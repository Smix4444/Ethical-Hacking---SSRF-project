# ──────────────────────────────────────────────────────────────
#  Normalize line endings. Files born on Windows (CRLF) otherwise
#  break inside Linux Docker containers: "/bin/sh^M: bad interpreter",
#  broken Dockerfiles, mangled config files. We force LF where it matters.
# ──────────────────────────────────────────────────────────────

# Default: let Git decide text vs binary and normalize on commit.
* text=auto

# ── Always LF (run inside Linux containers or parsed by tools) ──
*.sh            text eol=lf
*.bash          text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.env           text eol=lf
*.conf          text eol=lf
*.cfg           text eol=lf
*.ini           text eol=lf
*.toml          text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf
.gitkeep        text eol=lf

# ── Windows-only scripts keep CRLF ──
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# ── Binary — Git must never touch these ──
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.mp4   binary
*.webm  binary
*.zip   binary
